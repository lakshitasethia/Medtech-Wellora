# Wellora — environment configuration
# Copy to .env.local and fill in. .env.local is gitignored.

# --- Supabase (Phase 1) -------------------------------------------------
# Supabase dashboard → Project Settings → API
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# --- ML heart-risk service (Phase 2.4) ----------------------------------
# Base URL of the deployed FastAPI service exposing POST /predict.
# Leave blank to fall back to the local rule-based scorer.
VITE_ML_API_URL=

# --- Feature flags ------------------------------------------------------
# true  → run entirely off src/data/mockData.js (no network, demo-safe)
# false → read from Supabase
VITE_USE_MOCK=true
